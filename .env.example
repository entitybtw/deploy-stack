# deploy-stack — контейнер-менеджер (docker compose). Скопируй в .env и заполни.

# Порт, на который будет открыта панель
WEB_PORT=3000

# Учётные данные панели
DEPLOY_ADMIN_USER=admin
DEPLOY_ADMIN_PASS=change-me

# ── Опционально: CI/CD раннер (Forgejo/Gitea) ──
# Урл твоего гит-сервиса (только если хочешь авто-деплой по push)
DEPLOY_GIT_URL=http://git.example.com:3000
# Регистрационный токен раннера (см. админ панель Forgejo -> Runners)
DEPLOY_RUNNER_REGTOKEN=

# ── Продвинутое (обычно не трогать) ──
# Где менеджер хранит docker-compose.yml + data (обычно одно и то же, том ./deploy-data)
#DEPLOY_HOME=/deploy
# Корень данных раннера
#RUNNER_DATA=/runner
