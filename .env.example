# deploy-stack — контейнер-менеджер. Скопируй в .env (или запусти ./install.sh) и заполни.

# Порт, на который будет открыта панель
WEB_PORT=3000

# Учётные данные панели
DEPLOY_ADMIN_USER=admin
DEPLOY_ADMIN_PASS=change-me

# ── CI/CD раннер (Forgejo/Gitea) ──
# URL гит-сервиса (нужно только для авто-деплоя по push)
DEPLOY_GIT_URL=http://10.0.0.1:3000
# Регистрационный токен раннера (Forgejo -> Site Administration -> Actions -> Runners)
DEPLOY_RUNNER_REGTOKEN=

# ── Продвинутое (обычно не трогать) ──
#DEPLOY_HOME=/deploy
#DEPLOY_SITES=/deploy/sites/docker-compose.yml
#DEPLOY_RUNNERS=/deploy/runners/docker-compose.yml
#RUNNER_DATA=/runner
# Адрес, который печатается в отчёте деплоя (для удобства)
#DEPLOY_HOST=10.0.0.2
# Католог на ХОСТЕ с данными Forgejo-раннеров (для отображения labels в панели).
# По умолчанию ./forgejo-runner (создаётся install.sh). Если раннер лежит в
# /root/forgejo-runner, как на большинстве инсталляций — нужно раскомментировать:
#RUNNER_DATA_HOST=/root/forgejo-runner
